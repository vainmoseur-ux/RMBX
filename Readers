-- Fungsi mendapatkan target terdekat
local function GetClosestTarget()
    local closest = nil
    local shortestDist = FOV_Radius
    local cameraPos = Camera.CFrame.Position

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local humanoid = player.Character:FindFirstChild("Humanoid")
            local part = player.Character:FindFirstChild(TargetPart)
            if humanoid and part and humanoid.Health > 0 then
                local targetPos = part.Position
                local dist = (targetPos - cameraPos).Magnitude
                if dist < shortestDist then
                    shortestDist = dist
                    closest = player
                end
            end
        end
    end
    return closest
end

local function AimAndThrow()
    if not AimbotEnabled or not AttackHeld or not SpearthrowRemote then return end

    local target = GetClosestTarget()
    if not target or not target.Character then
        if Snapline then Snapline.Visible = false end
        return
    end

    local targetPart = target.Character:FindFirstChild(TargetPart)
    local killerChar = LocalPlayer.Character
    if not targetPart or not killerChar then
        if Snapline then Snapline.Visible = false end
        return
    end

    local killerRoot = killerChar:FindFirstChild("HumanoidRootPart")
    if not killerRoot then
        if Snapline then Snapline.Visible = false end
        return
    end

    local targetPos = targetPart.Position
    local origin = killerRoot.Position

    -- Update Snapline
    if SnaplineEnabled and Snapline then
        local killerScreenPos, kOn = Camera:WorldToScreenPoint(origin)
        local targetScreenPos, tOn = Camera:WorldToScreenPoint(targetPos)
        if kOn and tOn then
            Snapline.From = Vector2.new(killerScreenPos.X, killerScreenPos.Y)
            Snapline.To = Vector2.new(targetScreenPos.X, targetScreenPos.Y)
            Snapline.Visible = true
        else
            Snapline.Visible = false
        end
    end

    local direction = (targetPos - origin).Unit
    local distance = (targetPos - origin).Magnitude

    local args = {
        vector.create(direction.X, direction.Y, direction.Z),
        distance,
        vector.create(targetPos.X, targetPos.Y, targetPos.Z)
    }

    pcall(function()
        SpearthrowRemote:FireServer(unpack(args))
    end)
end


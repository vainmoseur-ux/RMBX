-- ===== CARI REMOTE SPEARTHROW (Otomatis di SEMUA Killers) =====
local SpearthrowRemote = nil
local remotePath = ""

local function FindSpearthrowRemote()
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    if not remotes then return nil end
    
    local killers = remotes:FindFirstChild("Killers")
    if not killers then return nil end
    
    for _, folder in ipairs(killers:GetChildren()) do
        if folder:IsA("Folder") or folder:IsA("Model") then
            for _, remote in ipairs(folder:GetChildren()) do
                if remote.Name:lower() == "spearthrow" then
                    return remote, folder.Name
                end
            end
        end
    end
    return nil, nil
end


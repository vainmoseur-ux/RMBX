local function AddESP(player)
    if player == LocalPlayer then return end
    
    local function setupHighlight(char)
        if highlightObjects[player] then
            highlightObjects[player]:Destroy()
            highlightObjects[player] = nil
        end
        
        local h = Instance.new("Highlight")
        h.Parent = game.CoreGui
        h.Adornee = char
        h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        
        if player.Team == LocalPlayer.Team then
            h.FillColor = Color3.fromRGB(0, 255, 180)
        else
            h.FillColor = Color3.fromRGB(255, 60, 60)
        end
        
        h.FillTransparency = 0.45
        h.OutlineColor = Color3.new(1, 1, 1)
        highlightObjects[player] = h
    end
    
    if player.Character then
        setupHighlight(player.Character)
    end
    
    player.CharacterAdded:Connect(function(char)
        setupHighlight(char)
    end)
end

local function SetESP(state)
    espEnabled = state
    if espEnabled then
        for _, plr in ipairs(Players:GetPlayers()) do
            AddESP(plr)
        end
        if not espConnection then
            espConnection = Players.PlayerAdded:Connect(function(plr)
                if espEnabled then AddESP(plr) end
            end)
        end
    else
        for _, h in pairs(highlightObjects) do
            h:Destroy()
        end
        highlightObjects = {}
        if espConnection then
            espConnection:Disconnect()
            espConnection = nil
        end
    end
end

local function UpdateTracers()
    if not tracerEnabled then
        for _, line in pairs(tracerLines) do
            line.Visible = false
        end
        return
    end
    
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            if not tracerLines[plr] then
                local line = Drawing.new("Line")
                line.Thickness = 2
                line.Transparency = 1
                tracerLines[plr] = line
            end
            
            local pos, onScreen = Camera:WorldToViewportPoint(
                plr.Character.HumanoidRootPart.Position
            )
            
            if onScreen then
                local line = tracerLines[plr]
                line.Visible = true
                line.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                line.To = Vector2.new(pos.X, pos.Y)
                
                if plr.Team == LocalPlayer.Team then
                    line.Color = Color3.fromRGB(0, 255, 180)
                else
                    line.Color = Color3.fromRGB(255, 60, 60)
                end
            else
                tracerLines[plr].Visible = false
            end
        end
    end
end

local function SetTracer(state)
    tracerEnabled = state
    if not tracerEnabled then
        for _, line in pairs(tracerLines) do
            line.Visible = false
        end
    end
end

local function SetFullbright(state)
    fullbrightEnabled = state
    if fullbrightEnabled then
        Lighting.Brightness = 4
        Lighting.ClockTime = 14
        Lighting.FogEnd = 100000
        Lighting.GlobalShadows = false
    else
        Lighting.Brightness = 2
        Lighting.GlobalShadows = true
    end
end

local function SetKillerAlert(state)
    killerAlertEnabled = state
end


-- SKILL CHECK (Survivor)
-- ============================================
local Check, LineRef, GoalRef, ActionRef
local function RefreshRefs()
    pcall(function()
        local sg = PlayerGui:FindFirstChild("SkillCheckPromptGui")
        if sg then Check, LineRef, GoalRef = sg:FindFirstChild("Check"), sg.Check and sg.Check:FindFirstChild("Line"), sg.Check and sg.Check:FindFirstChild("Goal") end
        local sm = PlayerGui:FindFirstChild("Survivor-mob")
        if sm and sm:FindFirstChild("Controls") then ActionRef = sm.Controls:FindFirstChild("action") end
    end)
end
RefreshRefs()
task.spawn(function() while true do RefreshRefs() task.wait(0.5) end end)

local function TriggerAction()
    if not ActionRef then RefreshRefs() end
    if not ActionRef then return false end
    if os.clock() - LastTrigger < TriggerDelay then return false end
    LastTrigger = os.clock()
    pcall(function() if ActionRef:IsA("GuiButton") then ActionRef:Activate() end end)
    if typeof(firesignal) == "function" then pcall(function() firesignal(ActionRef.MouseButton1Down) end) end
    return true
end

local function GetAngle() if LineRef and GoalRef then return tonumber(LineRef.Rotation) or 0, tonumber(GoalRef.Rotation) or 0 end end

RunService.RenderStepped:Connect(function()
    if not Enabled then PreviousVisible = false return end
    if not Check then RefreshRefs() end
    if not Check then return end
    local visible = Check.Visible
    if visible and not PreviousVisible then
        Busy = false
        if not ScourgeActive and Mode == "INSTANT" then
            local gr = tonumber(GoalRef.Rotation) or 0
            if LineRef then LineRef.Rotation = gr + 109 end
            TriggerAction()
        end
    end
    PreviousVisible = visible

    if visible and not ScourgeActive and not Busy then
        local should = false
        if Mode == "SUCCESS" then
            local lr, gr = GetAngle()
            if lr and lr >= gr + SUCCESS_MIN and lr <= gr + SUCCESS_MAX then should = true end
        elseif Mode == "NEUTRAL" then
            local lr, gr = GetAngle()
            if lr and lr > gr + NEUTRAL_MIN and lr <= gr + NEUTRAL_MAX then should = true end
        end
        if should then Busy = true TriggerAction() task.delay(0.07, function() Busy = false end) end
    end

    if ScourgeActive and visible then
        if Mode == "SUCCESS" and not Busy then
            local lr, gr = GetAngle()
            if lr and lr >= gr + SUCCESS_MIN and lr <= gr + SUCCESS_MAX then Busy = true TriggerAction() task.delay(0.06, function() Busy = false end) end
        elseif Mode == "INSTANT" then
            local lr, gr = GetAngle()
            if lr and gr and math.abs(lr - gr) > 130 then Busy = false end
        end
    end
end)

if KingScourgeStart then
    KingScourgeStart.OnClientEvent:Connect(function()
        if not Enabled then return end
        ScourgeActive, ScourgeRound, Busy = true, 0, false
        if Mode == "INSTANT" then
            task.defer(function() if Enabled and ScourgeActive then local gr = tonumber(GoalRef.Rotation) or 0 if LineRef then LineRef.Rotation = gr + 109 end TriggerAction() ScourgeRound = ScourgeRound + 1 end end)
        end
    end)
end
if KingScourgeEnd then KingScourgeEnd.OnClientEvent:Connect(function() ScourgeActive, Busy = false, false end) end

LocalPlayer.CharacterAdded:Connect(function()
    Busy, ScourgeActive, PreviousVisible = false, false, false
    task.wait(2)
    RefreshRefs()
    SetupAttack()
end)


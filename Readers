            if child.Name:lower() == "attack" and (child:IsA("ImageButton") or child:IsA("TextButton")) then
                AttackButton = child
                break
            end
        end
    end

    if not AttackButton then
        warn("⚠️ Tombol 'attack' TIDAK DITEMUKAN!")
        return
    end

    print("✅ Tombol 'attack' ditemukan di:", AttackButton:GetFullName())

    -- Hapus koneksi lama
    if AttackButton._connections then
        for _, con in ipairs(AttackButton._connections) do
            con:Disconnect()
        end
    end

    local function onPress()
        print("🔴 Tombol attack DITEKAN!")
        AttackHeld = true
        task.spawn(AimAndThrow)
    end
    local function onRelease()
        print("🟢 Tombol attack DILEPAS!")
        AttackHeld = false
        if Snapline then Snapline.Visible = false end
    end

    local con1 = AttackButton.MouseButton1Down:Connect(onPress)
    local con2 = AttackButton.MouseButton1Up:Connect(onRelease)
    local con3 = AttackButton.TouchBegan:Connect(onPress)
    local con4 = AttackButton.TouchEnded:Connect(onRelease)

    AttackButton._connections = {con1, con2, con3, con4}
end


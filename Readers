local TargetPart, AimbotEnabled, AttackHeld, AimDelay, LastAimTime, FOV_Radius = "Head", false, false, 0.15, 0, 100
local SpearthrowRemote = nil

-- Cari Remote Spearthrow (Otomatis)
local function FindRemote()
    local killers = RS:FindFirstChild("Remotes") and RS.Remotes:FindFirstChild("Killers")
    if killers then
        for _, folder in ipairs(killers:GetChildren()) do
            for _, remote in ipairs(folder:GetChildren()) do
                if remote.Name:lower() == "spearthrow" then return remote end
            end
        end
    end
    return nil
end
SpearthrowRemote = FindRemote()

-- Drawing (Snapline & FOV)
local Snapline, SnaplineEnabled = Drawing.new("Line"), true
Snapline.Thickness, Snapline.Color, Snapline.Transparency, Snapline.Visible = 2, Color3.fromRGB(255,0,0), 0.8, false
local FOVCircle = Drawing.new("Circle")
FOVCircle.Thickness, FOVCircle.Color, FOVCircle.Filled, FOVCircle.Transparency, FOVCircle.Radius = 2, Color3.fromRGB(255,255,255), false, 1, FOV_Radius
local function updateFOV() local v = Camera.ViewportSize FOVCircle.Position = Vector2.new(v.X/2, v.Y/2) end
updateFOV()
Camera:GetPropertyChangedSignal("ViewportSize"):Connect(updateFOV)

local function GetClosestTarget()
    local closest, shortDist, camPos = nil, FOV_Radius, Camera.CFrame.Position
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local part, hum = p.Character:FindFirstChild(TargetPart), p.Character:FindFirstChild("Humanoid")
            if hum and hum.Health > 0 and part then
                local dist = (part.Position - camPos).Magnitude
                if dist < shortDist then shortDist = dist closest = p end
            end
        end
    end
    return closest
end

local function AimAndThrow()
    if not AimbotEnabled or not AttackHeld or not SpearthrowRemote then return end
    local target, targetPart, killerChar = GetClosestTarget(), nil, LocalPlayer.Character
    if not target or not target.Character or not killerChar then if Snapline then Snapline.Visible = false end return end

    targetPart = target.Character:FindFirstChild(TargetPart)
    local killerRoot = killerChar:FindFirstChild("HumanoidRootPart")
    if not targetPart or not killerRoot then if Snapline then Snapline.Visible = false end return end

    local targetPos, origin = targetPart.Position, killerRoot.Position

    -- Snapline Update
    if SnaplineEnabled then
        local kScreen, kOn = Camera:WorldToScreenPoint(origin)
        local tScreen, tOn = Camera:WorldToScreenPoint(targetPos)
        if kOn and tOn then Snapline.From, Snapline.To, Snapline.Visible = Vector2.new(kScreen.X, kScreen.Y), Vector2.new(tScreen.X, tScreen.Y), true
        else Snapline.Visible = false end
    end

    local dir, dist = (targetPos - origin).Unit, (targetPos - origin).Magnitude
    SpearthrowRemote:FireServer(vector.create(dir.X, dir.Y, dir.Z), dist, vector.create(targetPos.X, targetPos.Y, targetPos.Z))
end

-- Deteksi Tombol Attack (Path: Slasher-mob)
local function SetupAttack()
    local btn = PlayerGui:FindFirstChild("Slasher-mob") and PlayerGui.Slasher-mob:FindFirstChild("Controls") and PlayerGui.Slasher-mob.Controls:FindFirstChild("attack")
    if not btn then
        for _, v in ipairs(PlayerGui:GetDescendants()) do if v.Name:lower() == "attack" and (v:IsA("ImageButton") or v:IsA("TextButton")) then btn = v break end end
    end
    if not btn then return warn("Attack button not found") end

    if btn._connections then for _, c in ipairs(btn._connections) do c:Disconnect() end end
    local function onPress() AttackHeld = true task.spawn(AimAndThrow) end
    local function onRelease() AttackHeld = false if Snapline then Snapline.Visible = false end end

    btn._connections = {
        btn.MouseButton1Down:Connect(onPress), btn.MouseButton1Up:Connect(onRelease),
        btn.TouchBegan:Connect(onPress), btn.TouchEnded:Connect(onRelease)
    }
end
task.wait(1) SetupAttack()

-- Loop Aim
RunService.RenderStepped:Connect(function()
    if AimbotEnabled and AttackHeld then local n = os.clock() if n - LastAimTime >= AimDelay then AimAndThrow() LastAimTime = n end
    else if Snapline then Snapline.Visible = false end end
end)

-- ============================================
-- ESP MODULE (Player, Tracer, Bright, Alert)
-- ============================================
local espEnabled, tracerEnabled, fullbrightEnabled, killerAlertEnabled = false, false, false, false
local highlights, tracers, lastAlert, espConn = {}, {}, 0, nil

local function AddESP(p)
    if p == LocalPlayer then return end
    local function setup(char)
        if highlights[p] then highlights[p]:Destroy() highlights[p] = nil end
        local h = Instance.new("Highlight")
        h.Parent, h.Adornee, h.DepthMode = game.CoreGui, char, Enum.HighlightDepthMode.AlwaysOnTop
        h.FillColor = (p.Team == LocalPlayer.Team) and Color3.fromRGB(0,255,180) or Color3.fromRGB(255,60,60)
        h.FillTransparency, h.OutlineColor = 0.45, Color3.new(1,1,1)
        highlights[p] = h
    end
    if p.Character then setup(p.Character) end
    p.CharacterAdded:Connect(setup)
end

local function SetESP(s)
    espEnabled = s
    if s then for _, p in ipairs(Players:GetPlayers()) do AddESP(p) end if not espConn then espConn = Players.PlayerAdded:Connect(function(p) if espEnabled then AddESP(p) end) end
    else for _, h in pairs(highlights) do h:Destroy() end highlights = {} if espConn then espConn:Disconnect() espConn = nil end end
end

local function UpdateTracers()
    if not tracerEnabled then for _, l in pairs(tracers) do l.Visible = false end return end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            if not tracers[p] then tracers[p] = Drawing.new("Line") tracers[p].Thickness, tracers[p].Transparency = 2, 1 end
            local pos, on = Camera:WorldToViewportPoint(p.Character.HumanoidRootPart.Position)
            local line = tracers[p]
            if on then
                line.Visible, line.From, line.To = true, Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y), Vector2.new(pos.X, pos.Y)
                line.Color = (p.Team == LocalPlayer.Team) and Color3.fromRGB(0,255,180) or Color3.fromRGB(255,60,60)
            else line.Visible = false end
        end
    end
end

local function SetTracer(s) tracerEnabled = s if not s then for _, l in pairs(tracers) do l.Visible = false end end end
local function SetFullbright(s) fullbrightEnabled = s Lighting.Brightness, Lighting.GlobalShadows = s and 4 or 2, not s if s then Lighting.ClockTime, Lighting.FogEnd = 14, 100000 end end
local function SetAlert(s) killerAlertEnabled = s end

